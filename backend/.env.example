# ==============================================================================
# CampusFlow Backend Environment Configuration Template
# Copy this file to .env and customize values for your local environment:
#   cp .env.example .env
#
# IMPORTANT: Never commit the actual .env file to version control.
# ==============================================================================

# Server Environment (development | production | test)
NODE_ENV=development

# Server Port (default: 5000)
PORT=5000

# API Route Prefix (default: /api)
API_PREFIX=/api

# Allowed Frontend Origins (Comma-separated for multiple origins)
# Example: http://localhost:5173,http://localhost:3000,https://campusflow.vercel.app
FRONTEND_URL=http://localhost:5173

# Database Connection (Neon PostgreSQL)
# For Neon serverless connections:
# DATABASE_URL: Pooled connection string (ends with -pooler.region.neon.tech / ?sslmode=require)
# Used by runtime queries through Prisma Client.
# DIRECT_URL: Direct connection string (non-pooled).
# Used by Prisma migrations and CLI commands to bypass connection poolers during schema alterations.
DATABASE_URL="postgresql://user:password@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require"

# JWT access tokens (required outside test). Use a unique random value of at least 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_ACCESS_SECRET="replace-with-a-random-32-character-secret"
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=7
JWT_ISSUER=campusflow
JWT_AUDIENCE=campusflow-api

# bcrypt cost. Use 12 outside local experiments.
BCRYPT_ROUNDS=12

# Login, registration, and refresh limit per client IP.
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=900000
