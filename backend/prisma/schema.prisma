// Prisma Schema for CampusFlow (PostgreSQL hosted on Neon)
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Baseline system health check model for Phase 00 foundation.
/// Speculative business models (Organizations, Memberships, Events) will be
/// introduced in later phases after team RFC review.
model SystemHealthCheck {
  id        String   @id @default(uuid())
  status    String   @default("OK")
  createdAt DateTime @default(now())

  @@map("system_health_checks")
}

/// Platform roles agreed for Phase 01.
/// Public registration always persists `member`. Privileged roles are assigned out of band.
enum UserRole {
  member
  volunteer
  door_staff
  treasurer
  admin
}

enum AccountStatus {
  active
  disabled
}

/// Application user. Password hashes and token versions are never returned by the API.
model User {
  id            String         @id @default(uuid())
  email         String         @unique
  name          String
  passwordHash  String
  role          UserRole       @default(member)
  status        AccountStatus  @default(active)
  tokenVersion  Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  refreshTokens RefreshToken[]

  @@index([role])
  @@map("users")
}

/// Opaque refresh tokens stored only as SHA-256 hashes. Rotation keeps the same familyId.
model RefreshToken {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash    String    @unique
  familyId     String
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  createdAt    DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}
