// Prisma Schema for CampusFlow (PostgreSQL hosted on Neon)
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Baseline system health check model for Phase 00 foundation.
model SystemHealthCheck {
  id        String   @id @default(uuid())
  status    String   @default("OK")
  createdAt DateTime @default(now())

  @@map("system_health_checks")
}

/// Canonical four roles for CampusFlow RBAC:
/// ADMIN (Admin / Organization President)
/// MEMBER (Club Member / Student)
/// EVENT_MANAGER (Event Manager / Volunteer)
/// TREASURER (Treasurer)
enum UserRole {
  ADMIN
  MEMBER
  EVENT_MANAGER
  TREASURER
}

enum AccountStatus {
  active
  disabled
}

enum MembershipStatus {
  PENDING
  ACTIVE
  EXPIRED
  SUSPENDED
  REJECTED
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

enum RegistrationStatus {
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED
  EXPIRED
}

enum PaymentStatus {
  CREATED
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum TicketStatus {
  ISSUED
  USED
  CANCELLED
}

enum TicketTier {
  MEMBER
  STANDARD
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum MerchOrderStatus {
  PLACED
  CANCELLED
}

enum AnnouncementStatus {
  DRAFT
  PUBLISHED
}

enum AnnouncementAudience {
  ALL_MEMBERS
  VOLUNTEERS
  EVENT_ATTENDEES
}

/// Application user. Password hashes and token versions are never returned by the API.
model User {
  id              String         @id @default(uuid())
  email           String         @unique
  name            String
  passwordHash    String
  role            UserRole       @default(MEMBER)
  status          AccountStatus  @default(active)
  tokenVersion    Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  refreshTokens     RefreshToken[]
  memberships       Membership[]
  organizedEvents   Event[]
  registrations     EventRegistration[]
  tickets           Ticket[]             @relation("TicketHolder")
  payments          Payment[]
  checkInsPerformed CheckIn[]            @relation("CheckInStaff")
  ticketsCheckedIn  Ticket[]             @relation("TicketCheckedInBy")
  merchOrders       MerchOrder[]
  announcements     Announcement[]
  organizedOpportunities VolunteerOpportunity[]   @relation("VolunteerOpportunityOrganizer")
  volunteerSignups       VolunteerRegistration[] @relation("VolunteerUserSignups")
  markedAttendances      VolunteerRegistration[] @relation("VolunteerAttendanceMarker")
  createdFundraisers     Fundraiser[]             @relation("FundraiserCreator")
  fundraiserDonations    FundraiserContribution[] @relation("FundraiserDonor")
  submittedExpenses      Expense[]                @relation("ExpenseSubmitter")
  reviewedExpenses       Expense[]                @relation("ExpenseReviewer")
  claimedReimbursements  Reimbursement[]          @relation("ReimbursementClaimant")
  reviewedReimbursements Reimbursement[]          @relation("ReimbursementReviewer")
  settledReimbursements  Reimbursement[]          @relation("ReimbursementSettler")

  @@index([role])
  @@map("users")
}

/// Opaque refresh tokens stored only as SHA-256 hashes. Rotation keeps the same familyId.
model RefreshToken {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash    String    @unique
  familyId     String
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  createdAt    DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

/// Organization membership pass for club members.
model Membership {
  id           String           @id @default(uuid())
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  memberCode   String           @unique
  planName     String
  status       MembershipStatus @default(PENDING)
  startDate    DateTime         @default(now())
  validUntil   DateTime
  renewalCount Int              @default(0)
  perks        String[]         @default([])
  adminNotes   String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([userId])
  @@index([status])
  @@map("memberships")
}

/// Club events, workshops, galas, and mixers.
model Event {
  id              String      @id @default(uuid())
  title           String
  description     String
  venue           String
  category        String?
  imageUrl        String?
  startsAt        DateTime
  endsAt          DateTime
  status          EventStatus @default(DRAFT)
  memberPrice     Int         @default(0)
  standardPrice   Int         @default(0)
  totalCapacity   Int?
  registeredCount Int         @default(0)
  isFeatured      Boolean     @default(false)
  organizerId     String
  organizer       User                @relation(fields: [organizerId], references: [id], onDelete: Restrict)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  registrations   EventRegistration[]
  tickets         Ticket[]
  payments        Payment[]
  checkIns        CheckIn[]
  volunteerOpportunities VolunteerOpportunity[]
  expenses        Expense[]

  @@index([organizerId])
  @@index([status])
  @@index([startsAt])
  @@map("events")
}

/// One row per user per event while the registration is pending or confirmed.
/// Cancelled and expired rows are kept for history. A partial unique index in the
/// Phase 03 migration enforces a single active row; that predicate cannot be
/// expressed in the Prisma schema language.
model EventRegistration {
  id          String             @id @default(uuid())
  eventId     String
  event       Event              @relation(fields: [eventId], references: [id], onDelete: Restrict)
  userId      String
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  status      RegistrationStatus
  tier        TicketTier
  quantity    Int                @default(1)
  amountPaise Int
  currency    String             @default("INR")
  cancelledAt DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  tickets     Ticket[]
  payments    Payment[]

  @@index([userId])
  @@index([eventId, status])
  @@map("event_registrations")
}

/// Server-created Razorpay order. Card data is never stored.
/// Partial unique indexes keep a single open attempt and a single settled payment.
model Payment {
  id                  String             @id @default(uuid())
  registrationId      String
  registration        EventRegistration  @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  eventId             String
  event               Event              @relation(fields: [eventId], references: [id], onDelete: Restrict)
  userId              String
  user                User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  razorpayOrderId     String?            @unique
  razorpayPaymentId   String?            @unique
  amountPaise         Int
  currency            String             @default("INR")
  status              PaymentStatus      @default(CREATED)
  signatureVerifiedAt DateTime?
  failureReason       String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([registrationId])
  @@index([userId])
  @@index([eventId])
  @@index([status])
  @@map("payments")
}

/// Opaque QR credential. The raw token is stored only as a hash plus an
/// AES-GCM ciphertext so it can be shown again to the owner.
model Ticket {
  id                           String            @id @default(uuid())
  registrationId               String
  registration                 EventRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  eventId                      String
  event                        Event             @relation(fields: [eventId], references: [id], onDelete: Restrict)
  userId                       String
  user                         User              @relation("TicketHolder", fields: [userId], references: [id], onDelete: Cascade)
  status                       TicketStatus      @default(ISSUED)
  verificationTokenHash        String            @unique
  encryptedVerificationToken   String
  issuedAt                     DateTime          @default(now())
  checkedInAt                  DateTime?
  checkedInById                String?
  checkedInBy                  User?             @relation("TicketCheckedInBy", fields: [checkedInById], references: [id], onDelete: SetNull)
  checkIn                      CheckIn?
  createdAt                    DateTime          @default(now())
  updatedAt                    DateTime          @updatedAt

  @@index([registrationId])
  @@index([eventId])
  @@index([userId])
  @@index([status])
  @@map("tickets")
}

/// Attendance row. ticketId is unique so a ticket can be checked in once.
model CheckIn {
  id          String   @id @default(uuid())
  ticketId    String   @unique
  ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  eventId     String
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Restrict)
  staffUserId String
  staff       User     @relation("CheckInStaff", fields: [staffUserId], references: [id], onDelete: Restrict)
  checkedInAt DateTime @default(now())

  @@index([eventId])
  @@index([staffUserId])
  @@map("check_ins")
}

/// Idempotency record for Razorpay webhook deliveries. The id is the provider event id.
model PaymentWebhookDelivery {
  id              String   @id
  eventType       String
  razorpayOrderId String?
  outcome         String
  createdAt       DateTime @default(now())

  @@index([razorpayOrderId])
  @@map("payment_webhook_deliveries")
}

/// Club merchandise. Prices are whole INR rupees, matching events.
/// Deactivation keeps the row so historical order lines can still reference it.
model Product {
  id            String          @id @default(uuid())
  name          String
  description   String
  imageUrl      String?
  category      String
  sku           String?         @unique
  memberPrice   Int
  standardPrice Int
  status        ProductStatus   @default(ACTIVE)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  variants      ProductVariant[]
  orderItems    MerchOrderItem[]

  @@index([status])
  @@index([category])
  @@map("products")
}

/// Available stock for one size. Orders decrement this only when stock is still sufficient.
model ProductVariant {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  size      String
  stock     Int

  @@unique([productId, size])
  @@map("product_variants")
}

/// Pickup order. Stock is taken when the order is placed. Payment is not collected here.
model MerchOrder {
  id             String           @id @default(uuid())
  orderNumber    String           @unique
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  status         MerchOrderStatus @default(PLACED)
  totalAmount    Int
  currency       String           @default("INR")
  idempotencyKey String?          @unique
  cancelledAt    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  items          MerchOrderItem[]

  @@index([userId, createdAt])
  @@index([status])
  @@map("merch_orders")
}

model MerchOrderItem {
  id          String     @id @default(uuid())
  orderId     String
  order       MerchOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product    @relation(fields: [productId], references: [id], onDelete: Restrict)
  size        String
  productName String
  unitPrice   Int
  quantity    Int
  lineTotal   Int

  @@index([orderId])
  @@index([productId])
  @@map("merch_order_items")
}

model Announcement {
  id          String                 @id @default(uuid())
  title       String
  body        String
  authorId    String
  author      User                   @relation(fields: [authorId], references: [id], onDelete: Restrict)
  status      AnnouncementStatus     @default(DRAFT)
  audience    AnnouncementAudience   @default(ALL_MEMBERS)
  publishedAt DateTime?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@index([status, publishedAt])
  @@index([authorId])
  @@map("announcements")
}

enum OpportunityStatus {
  DRAFT
  PUBLISHED
  CLOSED
  CANCELLED
}

enum VolunteerSignupStatus {
  REGISTERED
  ATTENDED
  CANCELLED
  NO_SHOW
}

enum FundraiserStatus {
  DRAFT
  ACTIVE
  CLOSED
  CANCELLED
}

enum ContributionStatus {
  PENDING
  VERIFIED
  FAILED
  REFUNDED
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ExpenseCategory {
  SUPPLIES
  TRAVEL
  VENUE
  REFRESHMENTS
  EQUIPMENT
  MARKETING
  OTHER
}

enum ReimbursementStatus {
  PENDING
  APPROVED
  REJECTED
  SETTLED
}

/// Volunteer opportunities for club events and community initiatives.
model VolunteerOpportunity {
  id                  String                 @id @default(uuid())
  title               String
  description         String
  location            String
  startsAt            DateTime
  endsAt              DateTime
  applicationDeadline DateTime?
  capacity            Int
  registeredCount     Int                    @default(0)
  status              OpportunityStatus      @default(DRAFT)
  category            String?
  eligibility         String?
  eventId             String?
  event               Event?                 @relation(fields: [eventId], references: [id], onDelete: SetNull)
  organizerId         String
  organizer           User                   @relation("VolunteerOpportunityOrganizer", fields: [organizerId], references: [id], onDelete: Restrict)
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  signups             VolunteerRegistration[]

  @@index([status, startsAt])
  @@index([organizerId])
  @@index([eventId])
  @@map("volunteer_opportunities")
}

/// Volunteer signups and attendance records.
model VolunteerRegistration {
  id              String                @id @default(uuid())
  opportunityId   String
  opportunity     VolunteerOpportunity  @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  userId          String
  user            User                  @relation("VolunteerUserSignups", fields: [userId], references: [id], onDelete: Cascade)
  status          VolunteerSignupStatus @default(REGISTERED)
  notes           String?
  attendanceNotes String?
  attendedAt      DateTime?
  attendedById    String?
  attendedBy      User?                 @relation("VolunteerAttendanceMarker", fields: [attendedById], references: [id], onDelete: SetNull)
  cancelledAt     DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@unique([opportunityId, userId])
  @@index([userId])
  @@index([opportunityId, status])
  @@map("volunteer_registrations")
}

/// Club fundraising initiatives.
model Fundraiser {
  id            String                   @id @default(uuid())
  title         String
  description   String
  purpose       String?
  goalAmount    Int
  currency      String                   @default("INR")
  status        FundraiserStatus         @default(DRAFT)
  startsAt      DateTime?
  deadline      DateTime?
  beneficiary   String?
  creatorId     String
  creator       User                     @relation("FundraiserCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  contributions FundraiserContribution[]
  expenses      Expense[]

  @@index([status])
  @@index([creatorId])
  @@map("fundraisers")
}

/// Contribution records for fundraisers.
model FundraiserContribution {
  id                String             @id @default(uuid())
  fundraiserId      String
  fundraiser        Fundraiser         @relation(fields: [fundraiserId], references: [id], onDelete: Cascade)
  donorId           String?
  donor             User?              @relation("FundraiserDonor", fields: [donorId], references: [id], onDelete: SetNull)
  donorName         String
  donorEmail        String
  amount            Int
  currency          String             @default("INR")
  paymentMethod     String             @default("ONLINE")
  status            ContributionStatus @default(PENDING)
  razorpayOrderId   String?            @unique
  razorpayPaymentId String?            @unique
  failureReason     String?
  verifiedAt        DateTime?
  idempotencyKey    String?            @unique
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([fundraiserId, status])
  @@index([donorId])
  @@map("fundraiser_contributions")
}

/// Club expenditure submissions.
model Expense {
  id              String          @id @default(uuid())
  title           String
  description     String
  amount          Int
  currency        String          @default("INR")
  category        ExpenseCategory @default(OTHER)
  expenseDate     DateTime
  receiptUrl      String?
  status          ExpenseStatus   @default(PENDING)
  submitterId     String
  submitter       User            @relation("ExpenseSubmitter", fields: [submitterId], references: [id], onDelete: Restrict)
  reviewerId      String?
  reviewer        User?           @relation("ExpenseReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  reviewedAt      DateTime?
  rejectionReason String?
  eventId         String?
  event           Event?          @relation(fields: [eventId], references: [id], onDelete: SetNull)
  fundraiserId    String?
  fundraiser      Fundraiser?     @relation(fields: [fundraiserId], references: [id], onDelete: SetNull)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  reimbursement   Reimbursement?

  @@index([submitterId])
  @@index([status])
  @@index([category])
  @@index([expenseDate])
  @@map("expenses")
}

/// Reimbursement requests linked to approved expenses.
model Reimbursement {
  id                  String              @id @default(uuid())
  expenseId           String              @unique
  expense             Expense             @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  claimantId          String
  claimant            User                @relation("ReimbursementClaimant", fields: [claimantId], references: [id], onDelete: Restrict)
  amount              Int
  currency            String              @default("INR")
  status              ReimbursementStatus @default(PENDING)
  reviewerId          String?
  reviewer            User?               @relation("ReimbursementReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  reviewedAt          DateTime?
  rejectionReason     String?
  settledById         String?
  settledBy           User?               @relation("ReimbursementSettler", fields: [settledById], references: [id], onDelete: SetNull)
  settledAt           DateTime?
  settlementReference String?
  notes               String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([claimantId])
  @@index([status])
  @@map("reimbursements")
}

